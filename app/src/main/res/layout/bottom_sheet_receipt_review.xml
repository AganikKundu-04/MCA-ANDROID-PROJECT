<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="@string/review_title"
            android:textColor="@color/lf_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Loading Skeleton / Progress State -->
        <LinearLayout
            android:id="@+id/layoutScanningState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="36dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/review_scanning_title"
                android:textColor="@color/lf_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/review_scanning_subtitle"
                android:textColor="@color/lf_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Review Form (Shown once Mirage OCR completes) -->
        <LinearLayout
            android:id="@+id/layoutReviewForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Preview Thumbnail + Metadata Strip -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LedgerFlow.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivReceiptPreview"
                        android:layout_width="68dp"
                        android:layout_height="90dp"
                        android:background="@drawable/bg_hairline_surface"
                        android:contentDescription="@string/cd_receipt_preview"
                        android:padding="1dp"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvScanMetaTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/lf_on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScanMetaDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/lf_on_surface_variant"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Prominent Warning Chips (FAILED/PENDING, CREDIT, Duplicate UTR, Partial Parse) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupWarnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <!-- Editable Amount -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReviewAmount"
                style="@style/Widget.LedgerFlow.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_amount_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReviewAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:inputType="numberDecimal"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Editable Merchant -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReviewMerchant"
                style="@style/Widget.LedgerFlow.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_merchant_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReviewMerchant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Auto-assigned Category Chips -->
            <TextView
                style="@style/TextAppearance.LedgerFlow.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/field_category_label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupReviewCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <!-- Payment Mode -->
            <TextView
                style="@style/TextAppearance.LedgerFlow.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/field_payment_mode_label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupReviewMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReviewUpi"
                    style="@style/Widget.LedgerFlow.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="UPI" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReviewCard"
                    style="@style/Widget.LedgerFlow.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Card" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReviewCash"
                    style="@style/Widget.LedgerFlow.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cash" />
            </com.google.android.material.chip.ChipGroup>

            <!-- UTR Reference -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReviewUtr"
                style="@style/Widget.LedgerFlow.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_utr_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReviewUtr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:fontFeatureSettings="tnum"
                    android:inputType="number"
                    android:maxLength="18" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiscardScan"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minHeight="48dp"
                    android:text="@string/action_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmSaveScan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/action_save_expense" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
